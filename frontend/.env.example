# Optional: where Next.js should proxy /v1/* in production (see next.config.mjs).
# Defaults to https://api.interviewbrain.xyz if unset.
# API_REWRITE_TARGET=https://api.interviewbrain.xyz

# Leave empty in production on Vercel so the browser calls same-origin /v1/...
# (Next rewrites forward to the API — avoids CORS).
# NEXT_PUBLIC_API_URL=
