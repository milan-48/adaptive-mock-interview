# Copy to .env and fill in (never commit .env)

PORT=3001
# Comma-separated browser origins allowed to call the API (credentials enabled).
# Example production:
# CORS_ORIGINS=https://interviewbrain.xyz,https://www.interviewbrain.xyz
CORS_ORIGINS=http://localhost:3000

# MongoDB (required for auth)
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-mock-interview

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Logging (winston): error | warn | info | debug
# LOG_LEVEL=info

# Single system admin (only this email may have role admin)
SUPER_ADMIN_EMAIL=mp890520@gmail.com

# One-time: npm run seed:admin — creates that super admin if missing
SEED_ADMIN_EMAIL=mp890520@gmail.com
SEED_ADMIN_PASSWORD=change-me-secure-password

# Gemini / Google AI — from Google AI Studio or Cloud Console
GEMINI_API_KEY=

# Google Cloud project (same project your API key belongs to)
# "Project name" in the console (human-readable label)
GOOGLE_CLOUD_PROJECT_NAME=

# Project ID — short id string (often lowercase, with hyphens)
GOOGLE_CLOUD_PROJECT=

# Project number — numeric id from project settings
GOOGLE_CLOUD_PROJECT_NUMBER=
